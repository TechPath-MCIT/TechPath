generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  roleId                   Int             @id @map("Role ID")
  role                     String?
  jobSatisfaction          Float?          @map("Job Satisfaction")
  entrySalary              Float?          @map("Entry Salary")
  salaryOutlook            Float?          @map("Salary Outlook")
  associates               Float?
  bachelors                Float?
  masters                  Float?
  phd                      Float?          @map("Ph.D")
  someCollegeWithoutDegree Float?          @map("EdLevel_Some college/university study without earning a degree")
  webFrameworkImportance   Float?          @map("WebFrameWork Importance")
  databaseImportance       Float?          @map("Database Importance")
  codingLanguageImportance Float?          @map("Coding Language Importance")
  mainResponsibilities     Json?           @map("main_responsibilities")
  positionInField          String?         @map("position_in_field")
  typicalJobTitles         Json?           @map("typical_job_titles")
  profiles                 Profile[]
  role_industry            role_industry[]
  role_skills              role_skills[]

  @@map("roles")
}

model Skill {
  skillId         Int               @id @map("id")
  name            String?           @map("name")
  type            String?           @map("type")
  profiles        Profile_Skills[]
  resource_skills resource_skills[]
  role_skills     role_skills[]

  @@map("skills")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_reviews {
  review_id          BigInt    @id @default(autoincrement())
  course_id          String
  source             String
  review             String?
  semester           String?
  publish_time       DateTime? @db.Date
  difficulty         Int?      @db.SmallInt
  workload           Decimal?  @db.Decimal(6, 2)
  rating             Int?      @db.SmallInt
  review_fingerprint String    @unique
  courses            courses   @relation(fields: [course_id], references: [course_id], onDelete: NoAction, onUpdate: NoAction)
}

model courses {
  course_id      String           @id
  course_name    String
  description    String?
  prerequisites  Json?
  course_units   Decimal?         @db.Decimal(3, 1)
  creators       Json?
  resource_id    String           @unique @db.Uuid
  course_reviews course_reviews[]
  resources      resources        @relation(fields: [resource_id], references: [resource_id], onUpdate: NoAction, map: "courses_resource_fk")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model role_industry {
  id       Int     @id
  Role_ID  Int?    @map("Role ID")
  industry String?
  share    Float?
  roles    Role?   @relation(fields: [Role_ID], references: [roleId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([Role_ID, industry])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model role_skills {
  Role_ID   Int?      @map("Role ID")
  Skill_ID  Int?      @map("Skill ID")
  count     Float?
  id        Int       @id @default(autoincrement())
  queryDate DateTime? @db.Date
  videoid   String?   @db.VarChar(255)
  roles     Role?     @relation(fields: [Role_ID], references: [roleId], onDelete: NoAction, onUpdate: NoAction)
  skills    Skill?    @relation(fields: [Skill_ID], references: [skillId], onDelete: NoAction, onUpdate: NoAction)
}

model Profile {
  profile_ID       Int                @id @default(autoincrement())
  fullname         String
  roleId           Int?
  highestDegree    String
  isTest           Boolean            @default(false)
  educationhistory Json?
  yearofexperience Int?
  profexperience   Json?
  skills           String?
  resumeid         Int?
  careerplanid     Int?
  location         String?
  Skills           Profile_Skills[]
  conversations    Conversation[]
  resume           Resume?            @relation(fields: [resumeid], references: [resumeid])
  dreamRole        Role?              @relation(fields: [roleId], references: [roleId])
  Resources        profile_resource[]
  User             User?

  @@map("profile")
}

model Profile_Skills {
  id        Int     @id @default(autoincrement())
  profileId Int
  skillId   Int
  Profile   Profile @relation(fields: [profileId], references: [profile_ID])
  Skills    Skill   @relation(fields: [skillId], references: [skillId])

  @@unique([profileId, skillId])
}

model User {
  id         Int      @id @default(autoincrement())
  username   String?  @db.VarChar(255)
  useremail  String?  @db.VarChar(255)
  profile_ID Int?     @unique
  clerkId    String   @unique
  profile    Profile? @relation(fields: [profile_ID], references: [profile_ID])

  @@map("userinfo")
}

model Resume {
  resumeid Int       @id @default(autoincrement())
  rawtext  String
  profiles Profile[]

  @@map("resumes")
}

model Conversation {
  conversationId Int      @id @default(autoincrement()) @map("conversation_id")
  profileId      Int      @map("profile_id")
  title          String?
  chatContext    Json     @map("chat_context")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  Profile        Profile  @relation(fields: [profileId], references: [profile_ID], onDelete: Cascade)

  @@index([profileId])
  @@map("conversations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resource_skills {
  resource_id     String    @db.Uuid
  skill_id        Int
  coverage_weight Decimal   @default(1.000) @db.Decimal(4, 3)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  resources       resources @relation(fields: [resource_id], references: [resource_id], onDelete: Cascade, onUpdate: NoAction, map: "resource_skills_resource_fk")
  skills          Skill     @relation(fields: [skill_id], references: [skillId], onUpdate: NoAction, map: "resource_skills_skill_fk")

  @@id([resource_id, skill_id])
  @@index([skill_id])
}

model resources {
  resource_id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource_type      String
  name               String
  description        String?
  source             String?
  source_url         String?
  pricing_type       String             @default("unknown")
  cost_amount        Decimal?           @db.Decimal(10, 2)
  cost_currency      String?            @db.Char(3)
  pricing_note       String?
  duration_minutes   Int?
  publication_status String             @default("published")
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  courses            courses?
  profile            profile_resource[]
  resource_skills    resource_skills[]

  @@index([source])
  @@index([resource_type, publication_status], map: "resources_type_status_idx")
}

model resource_status {
  status         String
  status_id      Int                @id @default(autoincrement())
  profile_status profile_resource[]
}

model profile_resource {
  id              Int             @id @default(autoincrement())
  profile_id      Int
  statusId        Int
  startDate       DateTime?       @db.Date
  expectedEndDate DateTime?       @db.Date
  resource_id     String          @db.Uuid
  profile         Profile         @relation(fields: [profile_id], references: [profile_ID])
  resource        resources       @relation(fields: [resource_id], references: [resource_id])
  status          resource_status @relation(fields: [statusId], references: [status_id])

  @@index([profile_id])
}
